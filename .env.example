# Smart Checkpoints variables are spelled SC_* across the ecosystem.

# WebSocket endpoint of the Smart Checkpoints driver channel. A map driver
# connects to the same channel a distance driver does, and says which it is.
SC_WS_URL=ws://localhost:3000/distance-driver

# Project API key. A map driver is an operator of its project, so this is the
# project's operator key rather than a camera's reporter key.
SC_API_KEY=replace-me

# Where this driver serves its map page.
#
# Loopback by default, like the server: this page carries the Mapbox token
# below and answers to anything that can reach it, so opening it to a network
# should be a decision somebody made.
SC_MAP_HOST=127.0.0.1
SC_MAP_PORT=4100

# The address announced to the server, and the one an operator approves.
#
# It is the address the *operator's browser* has to reach, which is not always
# the one this process binds to - a driver on another machine binds to its own
# interface and is reached by hostname. Leave it unset when they are the same.
# Changing it sends the console back to the approval screen, on purpose.
#SC_MAP_PUBLIC_URL=http://maps.internal:4100/

# Mapbox access token. Read from here and never committed: it reaches the
# browser through /env.js, because a Mapbox token is a browser credential.
# Scope it to the styles you use and rotate it at Mapbox, not here.
MAPBOX_TOKEN=replace-me

# Any Mapbox style URL. The default is light, which is what the console is.
MAPBOX_STYLE=mapbox://styles/mapbox/light-v11
